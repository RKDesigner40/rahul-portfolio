{
  "$description": "Design tokens for the Rahul Kulathoor portfolio. Mirrors the @theme block in src/app/globals.css. Format follows the W3C design tokens draft and imports into Figma via the Tokens Studio plugin, or can be mapped manually to Figma Variables.",
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#131312",
      "$description": "Page ground (site is dark)"
    },
    "surface": {
      "$type": "color",
      "$value": "#1B1B19",
      "$description": "Raised band: tools, About, Process; placeholder fill"
    },
    "surface-2": {
      "$type": "color",
      "$value": "#252522"
    },
    "line": {
      "$type": "color",
      "$value": "#2C2C29",
      "$description": "Hairline dividers"
    },
    "line-strong": {
      "$type": "color",
      "$value": "#43423D",
      "$description": "Outline buttons, dashed placeholders"
    },
    "ink": {
      "$type": "color",
      "$value": "#F3F2EC",
      "$description": "Primary text, filled buttons (16.6:1 on paper)"
    },
    "ink-soft": {
      "$type": "color",
      "$value": "#BDBCB4",
      "$description": "Body copy (9.8:1)"
    },
    "muted": {
      "$type": "color",
      "$value": "#8F8E87",
      "$description": "Labels, metadata (5.7:1 on paper, 5.0:1 on surface)"
    },
    "accent": {
      "$type": "color",
      "$value": "#F0784C",
      "$description": "Accent text, hover fill (6.6:1 on paper)"
    },
    "accent-bright": {
      "$type": "color",
      "$value": "#F0784C",
      "$description": "Hero selection frame, contact arrow, glow"
    },
    "accent-soft": {
      "$type": "color",
      "$value": "#3A2219"
    },
    "status": {
      "$type": "color",
      "$value": "#22A05A",
      "$description": "Availability dot"
    },
    "project": {
      "lottoposs": {
        "$type": "color",
        "$value": "#1E1836"
      },
      "purple-dotts": {
        "$type": "color",
        "$value": "#22142C"
      },
      "rc-marketspace": {
        "$type": "color",
        "$value": "#122030"
      },
      "dip-trading": {
        "$type": "color",
        "$value": "#221C12"
      },
      "vakmi": {
        "$type": "color",
        "$value": "#1B1F12"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "Inter Tight"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": "Instrument Serif"
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 500,
        "fontSize": "clamp(44px, 19.2px + 6.4vw, 116px)",
        "lineHeight": 0.98,
        "letterSpacing": "-0.045em"
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 500,
        "fontSize": "clamp(32px, 19.2px + 3.2vw, 64px)",
        "lineHeight": 1.02,
        "letterSpacing": "-0.035em"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 500,
        "fontSize": "clamp(24px, 18.4px + 1.2vw, 36px)",
        "lineHeight": 1.1,
        "letterSpacing": "-0.025em"
      }
    },
    "lead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": "clamp(18px, 16.3px + 0.45vw, 22px)",
        "lineHeight": 1.5,
        "letterSpacing": "-0.01em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": "16px",
        "lineHeight": 1.5,
        "letterSpacing": "0"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 500,
        "fontSize": "12px",
        "lineHeight": 1,
        "letterSpacing": "0.08em",
        "textCase": "uppercase"
      }
    },
    "accent-italic": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontWeight": 400,
        "fontStyle": "italic",
        "fontSize": "inherit",
        "lineHeight": "inherit",
        "letterSpacing": "-0.02em"
      }
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "6px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "card": {
      "$type": "dimension",
      "$value": "28px",
      "$description": "20px below 640px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "space": {
    "gutter-mobile": {
      "$type": "dimension",
      "$value": "16px"
    },
    "gutter-tablet": {
      "$type": "dimension",
      "$value": "32px"
    },
    "gutter-desktop": {
      "$type": "dimension",
      "$value": "48px"
    },
    "container-max": {
      "$type": "dimension",
      "$value": "1408px"
    },
    "section-mobile": {
      "$type": "dimension",
      "$value": "112px"
    },
    "section-desktop": {
      "$type": "dimension",
      "$value": "160px"
    }
  },
  "motion": {
    "ease-out-expo": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "ease-in-out-quart": {
      "$type": "cubicBezier",
      "$value": [
        0.76,
        0,
        0.24,
        1
      ]
    },
    "duration-hover": {
      "$type": "duration",
      "$value": "500ms"
    },
    "duration-reveal": {
      "$type": "duration",
      "$value": "900ms"
    },
    "duration-slide": {
      "$type": "duration",
      "$value": "750ms"
    }
  }
}
